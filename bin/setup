#!/bin/bash

# Meant to be run as root on an Ubuntu machine

# General dependencies
apt install rclone vim

# Setup rclone (insert real values)
mkdir -p ~/.config/rclone
cp /root/sigma-mirror/config/rclone.conf ~/.config/rclone/rclone.conf
echo "You must insert credentials manually in ~/.config/rclone/rclone.conf"

# Stable changes only on release day (sigma-mirror-sync-stable-from-rc), so
# remove the monthly timers that used to re-stage and upload it from upstream.
# Omarchy builds the T2 Mac packages itself, so the T2 sync is gone too.
for unit in sigma-mirror-stage-stable sigma-mirror-upload-stable sigma-mirror-t2-sync; do
  systemctl disable --now "$unit.timer" 2>/dev/null || true
  rm -f "/etc/systemd/system/$unit.timer" "/etc/systemd/system/$unit.service"
done

# Install hourly mirror service
cp /root/sigma-mirror/config/*mirror* /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now sigma-mirror-sync.timer
